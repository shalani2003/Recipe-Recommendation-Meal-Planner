{
  "openapi": "3.0.0",
  "info": {
    "title": "VitaPlate API Testing",
    "version": "1.0.0",
    "description": ""
  },
  "servers": [
    {
      "url": "{{base_url}}"
    }
  ],
  "paths": {
    "/api/register": {
      "post": {
        "summary": "Register API",
        "responses": {
          "201": {
            "description": "Register API",
            "headers": {
              "Server": {
                "schema": {
                  "type": "string"
                },
                "example": "Werkzeug/3.1.9 Python/3.12.10"
              },
              "Date": {
                "schema": {
                  "type": "string"
                },
                "example": "Thu, 05 Nov 2026 13:51:42 GMT"
              },
              "Content-Length": {
                "schema": {
                  "type": "integer"
                },
                "example": 101
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string"
                },
                "example": "nosniff"
              },
              "X-Frame-Options": {
                "schema": {
                  "type": "string"
                },
                "example": "DENY"
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string"
                },
                "example": "same-origin"
              },
              "Content-Security-Policy": {
                "schema": {
                  "type": "string"
                },
                "example": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store"
              },
              "Vary": {
                "schema": {
                  "type": "string"
                },
                "example": "Cookie"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "example": "session=eyJfcGVybWFuZW50Ijp0cnVlLCJ1c2VyX2lkIjoyfQ.auyJ7g.GkLbWuManR2CKiUUCnVUr6JfOWk; Expires=Thu, 12 Nov 2026 13:51:42 GMT; HttpOnly; Path=/; SameSite=Lax"
              },
              "Connection": {
                "schema": {
                  "type": "string"
                },
                "example": "close"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "recovery_code": {
                      "type": "string"
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string",
                          "format": "email"
                        },
                        "id": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "recovery_code": "3NYL-F7Q4-3J4H",
                  "user": {
                    "email": "qatester01@gmail.com",
                    "id": 2,
                    "name": "QA Tester"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "name": "QA Tester",
                "email": "qatester01@gmail.com",
                "password": "Test12345"
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Login API",
        "responses": {},
        "tags": [
