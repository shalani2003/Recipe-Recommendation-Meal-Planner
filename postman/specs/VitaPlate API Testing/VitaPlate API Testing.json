                    "type": "string"
                  }
                }
              },
              "example": {
                "email": "qatester01@gmail.com",
                "password": "Test12345"
              }
            }
          }
        }
      }
    },
    "/api/pantry": {
      "post": {
        "summary": "Add Pantry Item",
        "responses": {
          "201": {
            "description": "Add Pantry Item",
            "headers": {
              "Server": {
                "schema": {
                  "type": "string"
                },
                "example": "Werkzeug/3.1.9 Python/3.12.10"
              },
              "Date": {
                "schema": {
                  "type": "string"
                },
                "example": "Thu, 05 Nov 2026 13:58:57 GMT"
              },
              "Content-Length": {
                "schema": {
                  "type": "integer"
                },
                "example": 194
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string"
                },
                "example": "nosniff"
              },
              "X-Frame-Options": {
                "schema": {
                  "type": "string"
                },
                "example": "DENY"
              },
              "Referrer-Policy": {
                "schema": {
                  "type": "string"
                },
                "example": "same-origin"
              },
              "Content-Security-Policy": {
                "schema": {
                  "type": "string"
                },
                "example": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; frame-ancestors 'none'"
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "example": "no-store"
              },
              "Vary": {
                "schema": {
                  "type": "string"
                },
                "example": "Cookie"
              },
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "example": "session=eyJfcGVybWFuZW50Ijp0cnVlLCJ1c2VyX2lkIjoyfQ.auyLoQ.7wASoMgkskBql05SlWrMTZyMcYQ; Expires=Thu, 12 Nov 2026 13:58:57 GMT; HttpOnly; Path=/; SameSite=Lax"
              },
              "Connection": {
                "schema": {
                  "type": "string"
                },
                "example": "close"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "item": {
                      "type": "object",
                      "properties": {
                        "cat": {
                          "type": "string"
                        },
                        "category": {
                          "type": "string"
                        },
                        "days_left": {
                          "type": "integer"
                        },
                        "exp": {
                          "type": "string",
                          "format": "date"
                        },
                        "expiry_date": {
                          "type": "string",
                          "format": "date"
                        },
                        "id": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        },
                        "qty": {
                          "type": "integer"
                        },
                        "quantity": {
                          "type": "integer"
                        },
                        "state": {
                          "type": "string"
                        },
                        "unit": {
                          "type": "string"
                        }
                      }
                    },
                    "merged": {
                      "type": "boolean"
                    }
                  }
                },
                "example": {
                  "item": {
                    "cat": "Fruits",
                    "category": "Fruits",
                    "days_left": 5,
                    "exp": "2026-11-10",
                    "expiry_date": "2026-11-10",
                    "id": 9,
                    "name": "Apple",
                    "qty": 5,
                    "quantity": 5,
                    "state": "ok",
                    "unit": "pcs"
                  },
                  "merged": false
                }
              }
            }
          }
        },
        "tags": [
          "Pantry"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  },
                  "expiry_date": {
                    "type": "string",
                    "format": "date"
                  }
                }
              },
              "example": {
                "name": "Apple",
                "quantity": 5,
                "unit": "pcs",
                "category": "Fruits",
                "expiry_date": "2026-11-10"
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get All Items",
        "responses": {},
        "tags": [
          "Pantry"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
